---
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import { locales, isLocale, translate, type Locale } from "../../i18n";
import { ui } from "../../i18n/ui";
import { chapters } from "../../content/chapters";
import { timeline } from "../../content/timeline";
import { renderChapter } from "../../lib/content";
import { asset, urlFor } from "../../lib/routes";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Unsupported language");
const locale: Locale = lang;
const u = ui(locale);
const roman = ["I", "II", "III", "IV", "V", "VI", "VII"];
const book = {
  es: { memories: "Memorias de una familia", index: "Índice", begin: "Comenzar a leer", top: "Volver a la portada" },
  en: { memories: "Memories of a family", index: "Contents", begin: "Begin reading", top: "Back to the cover" },
  de: { memories: "Erinnerungen einer Familie", index: "Inhalt", begin: "Lesen beginnen", top: "Zurück zum Buchcover" },
  pl: { memories: "Wspomnienia rodziny", index: "Spis treści", begin: "Rozpocznij lekturę", top: "Powrót do okładki" }
}[locale];
---
<ArchiveLayout locale={locale} title={u.heroTitle} description={u.heroIntro} currentPath="">
  <div class="book-volume">
    <section class="book-cover" id="cover" aria-labelledby="book-title">
      <div class="book-cover-frame">
        <p class="book-eyebrow">{book.memories}</p>
        <div class="book-ornament" aria-hidden="true">❦</div>
        <figure class="book-portrait">
          <img src={asset("Eric Paul Schneider.png")} alt="Erich Paul Schneider" fetchpriority="high" />
        </figure>
        <h1 id="book-title"><em>Erich Paul</em><br />Schneider</h1>
        <div class="book-ornament" aria-hidden="true">◇</div>
        <p class="book-subtitle">{u.heroTitle.replace(/\.$/, "")}</p>
        <p class="book-dates">1905 — 1975</p>
        <p class="book-places">Breslau · Bremen<br />Buenos Aires · Deán Funes</p>
        <a class="book-begin" href="#contents">{book.begin}<span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <section class="book-paper" id="contents" aria-labelledby="contents-title">
      <div class="book-running"><span>{book.memories}</span><span>{book.index}</span></div>
      <div class="book-ornament" aria-hidden="true">❧</div>
      <h2 id="contents-title">{book.index}</h2>
      <p class="book-intro">{u.storyIntro}</p>
      <ol class="book-index">
        {chapters.map((chapter, index) => (
          <li><a href={"#" + chapter.id}><span class="book-roman">{roman[index]}.</span><span>{translate(locale, chapter.titleKey)}</span><span class="book-period">{chapter.period}</span></a></li>
        ))}
        <li><a href="#cronologia"><span class="book-roman">·</span><span>{u.chronology}</span></a></li>
        <li><a href={urlFor(locale,"archivo")}><span class="book-roman">·</span><span>{u.archiveTitle}</span></a></li>
        <li><a href={urlFor(locale,"familia")}><span class="book-roman">·</span><span>{u.familyTitle}</span></a></li>
        <li><a href="#thanks"><span class="book-roman">·</span><span>{translate(locale,"nav_thanks")}</span></a></li>
      </ol>
      <p class="book-intro">{u.heroIntro}</p>
      <blockquote class="book-quote">
        <p>{translate(locale,"quote_text")}</p>
        <cite>{translate(locale,"quote_cite")}</cite>
      </blockquote>
    </section>
    {chapters.map((chapter, index) => (
      <section class="book-paper book-chapter" id={chapter.id} aria-labelledby={"title-" + chapter.id}>
        <div class="book-running"><span>Erich Paul Schneider</span><span>{chapter.period}</span></div>
        <p class="book-chapter-label">{u.chapter} {roman[index]}</p>
        <h2 id={"title-" + chapter.id}>{translate(locale,chapter.titleKey)}</h2>
        <p class="book-period-title">{chapter.period}</p>
        <div class="book-rule" aria-hidden="true"></div>
        <article class="prose" set:html={renderChapter(chapter.html,locale)} />
        <div class="book-endmark" aria-hidden="true">❧</div>
        <a class="book-back" href="#contents">{book.index} ↑</a>
      </section>
    ))}
    <section class="book-paper" id="cronologia">
      <div class="book-running"><span>Erich Paul Schneider</span><span>1876 — 2026</span></div>
      <h2>{u.chronologyTitle}</h2>
      <div class="book-rule" aria-hidden="true"></div>
      <div class="timeline-list">
        {timeline.map((event) => <div class="timeline-entry"><time>{event.year}</time><p set:html={translate(locale,event.key)} /></div>)}
      </div>
      <div class="book-appendix"><a href={urlFor(locale,"archivo")}>{u.archiveTitle} →</a><a href={urlFor(locale,"familia")}>{u.familyTitle} →</a></div>
    </section>
    <section class="book-paper" id="thanks">
      <h2>{translate(locale,"ch_thanks_title")}</h2>
      <div class="book-rule" aria-hidden="true"></div>
      <div class="prose">
        {["ch_thanks_intro","ch_thanks_ewa","ch_thanks_leonardo","ch_thanks_grossgraben","ch_thanks_friends"].map(key => <p set:html={translate(locale,key)} />)}
      </div>
      <aside class="note"><strong>{u.noteHeading}</strong><p>{u.noteBody}</p></aside>
      <div class="book-endmark" aria-hidden="true">❦</div>
      <a class="book-back" href="#cover">{book.top} ↑</a>
    </section>
  </div>
</ArchiveLayout>
