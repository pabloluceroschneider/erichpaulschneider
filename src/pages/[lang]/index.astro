---
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import { locales, isLocale, translate, type Locale } from "../../i18n";
import { ui } from "../../i18n/ui";
import { chapters } from "../../content/chapters";
import { timeline } from "../../content/timeline";
import { excerpt } from "../../lib/content";
import { asset, urlFor } from "../../lib/routes";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Unsupported language");
const locale: Locale = lang;
const u = ui(locale);
const featured = [chapters[0], chapters[2], chapters[6]];
const highlights = timeline.filter((event) => ["1905", "1926", "1949", "2026"].includes(event.year));
---
<ArchiveLayout locale={locale} title={u.heroTitle} description={u.heroIntro} currentPath="">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">{u.collection} / 1905–1975</p>
        <h1 id="hero-title">{u.heroTitle}</h1>
        <p class="hero-intro">{u.heroIntro}</p>
        <div class="hero-meta">
          <span><strong>1905</strong> · Breslau</span>
          <span><strong>1926</strong> · Buenos Aires</span>
          <span><strong>1975</strong> · Deán Funes</span>
        </div>
        <a class="button-link" href={urlFor(locale,"historia")}>{u.heroAction} <span aria-hidden="true">→</span></a>
      </div>
      <figure class="hero-media">
        <img src={asset("Eric Paul Schneider.png")} alt="Erich Paul Schneider" fetchpriority="high" />
        <figcaption>Erich Paul Schneider · 1905–1975</figcaption>
      </figure>
    </section>
  </div>

  <section class="section-wrap soft" aria-labelledby="chapter-feature-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{u.storyEyebrow}</p>
          <h2 id="chapter-feature-title">{u.storyTitle}</h2>
        </div>
        <a class="text-link" href={urlFor(locale,"historia")}>{u.backToStory} →</a>
      </div>
      <div class="intro-grid">
        {featured.map((chapter, index) =>
          <a class="intro-card" href={urlFor(locale,"historia/" + chapter.slug)}>
            <span class="number">{String(index + 1).padStart(2, "0")} / {chapter.period}</span>
            <h3>{translate(locale, chapter.titleKey)}</h3>
            <p>{excerpt(locale, chapter.summaryKey, 175)}</p>
            <span class="card-action">{u.readChapter} →</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section-wrap" aria-labelledby="timeline-feature-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{u.timelineEyebrow}</p>
          <h2 id="timeline-feature-title">{u.selectedEvents}</h2>
        </div>
        <a class="text-link" href={urlFor(locale,"cronologia")}>{u.chronology} →</a>
      </div>
      <div class="timeline-list">
        {highlights.map((event) =>
          <div class="timeline-entry">
            <time>{event.year}</time>
            <p set:html={translate(locale,event.key)} />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section-wrap soft">
    <div class="container return-panel">
      <div>
        <p class="eyebrow">{u.returnEyebrow}</p>
        <h2>{u.returnTitle}</h2>
      </div>
      <div>
        <p>{u.returnText}</p>
        <a class="button-link" href={urlFor(locale,"historia/el-regreso")}>{u.readChapter} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</ArchiveLayout>
